rm-meas:RTI-23-ptm-weblayout
    a owl:NamedIndividual , a-dd:Measurement ;
    a-dd:hasMeasurementType rm-mtype:rti-web-layout ;
    muapit:value "deepzoom"^^xsd:string ;
    rdfs:label "Web layout: DeepZoom tiles — RTI-23"@en .

rm-meas:RTI-23-ptm-colorprofilemode
    a owl:NamedIndividual , a-dd:Measurement ;
    a-dd:hasMeasurementType rm-mtype:rti-color-profile-mode ;
    muapit:value "Linear RGB"^^xsd:string ;
    rdfs:label "Colour profile mode: Linear RGB — RTI-23"@en .

rm-meas:RTI-23-ptm-openlime
    a owl:NamedIndividual , a-dd:Measurement ;
    a-dd:hasMeasurementType rm-mtype:rti-openlime ;
    muapit:value "true"^^xsd:boolean ;
    rdfs:label "OpenLime viewer: true — RTI-23"@en .

rm-meas:RTI-23-ptm-croporigin
    a owl:NamedIndividual , a-dd:Measurement ;
    a-dd:hasMeasurementType rm-mtype:rti-crop-origin ;
    muapit:value "x=50 y=310 angle=0.0"^^xsd:string ;
    rdfs:label "Crop origin — RTI-23"@en .

